# =============================================================================
# SchemaSentinel — Environment Configuration
# Copy to .env and fill in values before running.
#
# Local Python (Windows):
#   cd apps\api
#   python -m venv venv
#   .\venv\Scripts\activate
#   pip install -r requirements.txt
# =============================================================================

# Application
APP_NAME=SchemaSentinel
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Security
API_KEY=change-me-to-a-strong-secret
SECRET_KEY=change-me-jwt-or-session-secret

# PostgreSQL
# Host port 5434 — Docker maps 5434->5432 (avoids local Windows Postgres / OpsPilot on 5433)
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5434/schemasentinel
DATABASE_URL_SYNC=postgresql://sentinel:sentinel@localhost:5434/schemasentinel

# Redis
REDIS_URL=redis://localhost:6380/0

# OpenAI (required for live LLM mode; leave blank to use deterministic mock reasoner)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Analysis behaviour
AGENT_MODE=auto
# auto | openai | mock
RISK_THRESHOLD_HIGH=0.7
RISK_THRESHOLD_MEDIUM=0.4
DEFAULT_TABLE_ROW_ESTIMATE=1000000

# Optional live DB stats (stretch) — leave blank for synthetic metadata
TARGET_DATABASE_URL=

# GitHub integration (optional — webhook + PR comments)
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_CHECK_NAME=SchemaSentinel

# OpenTelemetry (off by default for local; no collector required)
OTEL_ENABLED=false
OTEL_EXPORT_OTLP=false
OTEL_SERVICE_NAME=schema-sentinel-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=change-me-to-a-strong-secret
